<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- An example of an airline's own application signing its team in with Login with vaBase.
       Standalone: it is not part of any vaBase solution and references no vaBase code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LoginWithVaBase</RootNamespace>
    <!-- The client secret is read from .NET user secrets while developing, never from a file in the project. -->
    <UserSecretsId>login-with-vabase-example</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft's OpenID Connect handler for ASP.NET Core. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
  </ItemGroup>

</Project>
